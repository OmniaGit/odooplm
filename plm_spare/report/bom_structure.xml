<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="plm_spare.pdf_all">
        <t t-foreach="docs" t-as="o">
            <div class="o_composer_container">
                <embed width="100%" height="100%" t-att-src="get_content(o)"/>
            </div>
        </t>
    </template>

    <template id="plm_spare.pdf_one">
        <t t-foreach="docs" t-as="o">
            <div class="o_composer_container">
                <embed width="100%" height="100%" t-att-src="get_content(o)"/>
            </div>
        </t>
    </template>

    <template id="plm_spare.bom_spare_header">
        <t t-foreach="docs" t-as="compBrws">
            <t t-call="web.html_container">
                <t t-set="data_report_margin_top" t-value="12"/>
                <t t-set="data_report_header_spacing" t-value="9"/>
                <t t-set="data_report_dpi" t-value="110"/>
                <t t-call="web.internal_layout">
                    <div class="page" align="center">
                        <t t-set="docBrws" t-value="get_document_brws(compBrws)"/>
                        <div style="position: relative;top: 50mm;">
                            <div>
                                <h1>
                                    <b>Spare Parts Report</b>
                                </h1>
                                <span
                                    t-esc="compBrws.product_tmpl_id.engineering_code or compBrws.product_tmpl_id.default_code"/>
                                <span t-esc="compBrws.product_tmpl_id.name"/>
                            </div>
                            <div id="spare_header_image" style="position: relative;top: 80px;">
                                <!-- The picture of the product comes first: it is
                                     what the cover of a spare parts manual shows.
                                     The preview of its oldest document is only the
                                     fallback for products that carry no image.

                                     Both are embedded with image_data_uri instead
                                     of pointing at /plm/..., because the PDF is
                                     rendered by wkhtmltopdf: it would have to
                                     fetch that URL over HTTP, against web.base.url
                                     and with a session, and any of the two being
                                     off leaves an empty box on the cover. -->
                                <t t-if="compBrws.image_1920">
                                    <img class="image"
                                         t-att-src="image_data_uri(compBrws.image_1920)"
                                         t-att-alt="compBrws.display_name"
                                         style="height: auto;width: 150mm;box-shadow: 1px 1px 2px 3px lightgrey;"/>
                                </t>
                                <t t-elif="docBrws and docBrws.preview">
                                    <img t-att-src="image_data_uri(docBrws.preview)"
                                         t-att-alt="docBrws.display_name"
                                         style="height: auto;width: 150mm;box-shadow: 1px 1px 2px 3px lightgrey;"/>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
