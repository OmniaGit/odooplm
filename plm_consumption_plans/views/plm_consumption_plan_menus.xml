<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action -->
    <record id="action_template_consumption_plan" model="ir.actions.act_window">
        <field name="name">Template Consumption Plans</field>
        <field name="res_model">template.consumption.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first consumption plan Template.
            </p>
        </field>
    </record>

    <!-- Main Menu -->
    <menuitem id="menu_template_consumption_plan_root" name="Template Consumption Plans" sequence="10"/>

    <!-- Submenu -->
    <menuitem id="menu_template_consumption_plan_main" name="Template Consumption Plans"
              parent="menu_template_consumption_plan_root"
              action="action_template_consumption_plan" sequence="1"/>

</odoo>
