<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="plm_compare_bom.CompareBomTree">
        <div class="o_action o_plm_compare_bom_tree">
            <Layout display="{ controlPanel: {} }">
                <t t-set-slot="control-panel-create-button">
                    <div class="d-flex gap-1" t-if="state.data">
                        <button t-if="hasPending" class="btn btn-primary o_plm_save_quantities"
                                t-on-click="() => this.saveQuantities()">Save</button>
                        <button t-if="hasPending" class="btn btn-secondary"
                                t-on-click="() => this.discardQuantities()">Discard</button>
                        <button t-attf-class="btn {{ hasPending ? 'btn-secondary' : 'btn-primary' }} o_plm_compare_level_root"
                                t-on-click="() => this.openLevel(state.data.left.id, state.data.right.id)">
                            Compare this level
                        </button>
                        <button class="btn btn-secondary" t-on-click="() => this.foldAll(false)">Unfold all</button>
                        <button class="btn btn-secondary" t-on-click="() => this.foldAll(true)">Fold all</button>
                    </div>
                </t>
                <t t-set-slot="layout-actions">
                    <div class="form-check form-switch ms-2" t-if="state.data">
                        <input class="form-check-input o_plm_only_differences" type="checkbox"
                               id="plm_only_differences" t-model="state.onlyDifferences"/>
                        <label class="form-check-label" for="plm_only_differences">Only differences</label>
                    </div>
                </t>

                <div t-if="!state.data" class="alert alert-warning m-3">
                    This page does not know which two bills of material to compare:
                    open it again from the Compare BoMs wizard.
                </div>
                <div t-else="" class="container-fluid overflow-auto bg-view pb-3">
                    <div class="row g-3 my-1">
                        <t t-foreach="['left', 'right']" t-as="side" t-key="side">
                            <t t-set="bom" t-value="state.data[side]"/>
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-body py-2">
                                        <div class="text-muted small">
                                            <t t-if="side === 'left'">Left</t>
                                            <t t-else="">Right</t>
                                        </div>
                                        <a href="#" class="fw-bold" t-on-click.prevent="() => this.openBom(bom.id)"
                                           t-esc="bom.name"/>
                                        <div class="small">
                                            <t t-esc="bom.type"/>
                                            <t t-if="bom.engineering_code">
                                                · <t t-esc="bom.engineering_code"/>
                                                rev. <t t-esc="bom.engineering_revision"/>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div t-if="state.data.tree.note" class="alert alert-info my-2" t-esc="state.data.tree.note"/>
                    <div class="d-flex flex-wrap gap-2 my-2 o_plm_compare_summary">
                        <t t-foreach="summary" t-as="item" t-key="item.status">
                            <span t-attf-class="badge {{ item.badge }}">
                                <t t-esc="item.label"/>: <t t-esc="item.count"/>
                            </span>
                        </t>
                        <span t-if="!summary.length and !state.data.tree.note" class="badge text-bg-success">
                            The two bills of material are identical
                        </span>
                    </div>

                    <table class="table table-sm table-hover align-middle">
                        <thead>
                            <tr>
                                <th/>
                                <th>Code</th>
                                <th>Description</th>
                                <th class="text-end">Pos.</th>
                                <th class="text-end">Left rev.</th>
                                <th class="text-end">Left qty</th>
                                <th class="text-end">Right rev.</th>
                                <th class="text-end">Right qty</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="rows" t-as="line" t-key="line.path"
                                t-att-class="statuses[line.row.status].row"
                                t-att-data-code="label(line.row)">
                                <td>
                                    <button t-if="line.row.bom_left_id and line.row.bom_right_id"
                                            class="btn btn-link btn-sm p-0 o_plm_compare_level"
                                            title="Compare this level"
                                            t-on-click="() => this.openLevel(line.row.bom_left_id, line.row.bom_right_id)">
                                        <i class="fa fa-columns"/>
                                    </button>
                                    <button t-elif="line.row.bom_left_id or line.row.bom_right_id"
                                            class="btn btn-link btn-sm p-0 o_plm_open_bom"
                                            title="Open its bill of material: it exists on one side only"
                                            t-on-click="() => this.openBom(line.row.bom_left_id or line.row.bom_right_id)">
                                        <i class="fa fa-sitemap"/>
                                    </button>
                                </td>
                                <td t-attf-style="padding-left: {{ 0.5 + line.depth * 1.5 }}rem">
                                    <button t-if="line.foldable" class="btn btn-link p-0 me-1 o_plm_fold"
                                            t-on-click="() => this.toggleFold(line.path)">
                                        <i t-attf-class="fa fa-fw {{ state.folded[line.path] ? 'fa-caret-right' : 'fa-caret-down' }}"/>
                                    </button>
                                    <span t-else="" class="d-inline-block me-1" style="width: 1.25em"/>
                                    <t t-esc="label(line.row)"/>
                                </td>
                                <td t-esc="line.row.name"/>
                                <td class="text-end" t-esc="line.row.itemnum or ''"/>
                                <t t-foreach="['left', 'right']" t-as="side" t-key="side">
                                    <td class="text-end" t-esc="revision(line.row, side)"/>
                                    <td class="text-end">
                                        <input t-if="editableLine(line.row, side)" type="number" step="any"
                                               t-attf-class="form-control form-control-sm text-end d-inline-block o_plm_qty {{ editableLine(line.row, side) in state.pending ? 'border-warning' : '' }}"
                                               style="width: 6rem" t-att-data-side="side"
                                               t-att-value="shownQuantity(line.row, side)"
                                               t-on-change="(ev) => this.onQuantityChange(editableLine(line.row, side), ev)"/>
                                        <span t-elif="quantity(line.row, side) !== ''" t-esc="quantity(line.row, side)"
                                              title="Several bill lines: change them from the bill of material"/>
                                    </td>
                                </t>
                                <td>
                                    <span t-esc="statuses[line.row.status].label"/>
                                    <div t-if="line.row.note" class="small text-muted fst-italic"
                                         t-esc="line.row.note"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </Layout>
        </div>
    </t>
</templates>
