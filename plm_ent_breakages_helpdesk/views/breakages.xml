<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="breakages_form_view_hinerith" model="ir.ui.view">
            <field name="name">breakages.form.view.hinerith</field>
            <field name="model">plm.breakages</field>
            <field name="inherit_id" ref="plm_breakages.breakages_form_view"/>
            <field name="arch" type="xml">
                 <xpath expr="//notebook" position="inside">
                     <page string="Ticket">
                         <field name="ticket_ids" nolabel="1"/>
                     </page>
                 </xpath>
            </field>
        </record>
    </data>
</odoo>
