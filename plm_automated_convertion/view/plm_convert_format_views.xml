<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List View -->
    <record id="plm_convert_format_list_view" model="ir.ui.view">
        <field name="name">plm.convert.format.list</field>
        <field name="model">plm.convert.format</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="start_format"/>
                <field name="end_format"/>
                <field name="cad_name"/>
                <field name="server_id"/>
                <field name="available"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="plm_convert_format_form_view" model="ir.ui.view">
        <field name="name">plm.convert.format.form</field>
        <field name="model">plm.convert.format</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="start_format" required="1"/>
                            <field name="end_format" required="1"/>
                        </group>
                        <group>
                            <field name="cad_name" required="1"/>
                            <field name="server_id" required="1"/>
                            <field name="available"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="plm_convert_format_search_view" model="ir.ui.view">
        <field name="name">plm.convert.format.search</field>
        <field name="model">plm.convert.format</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="start_format"/>
                <field name="end_format"/>
                <field name="cad_name"/>
                <field name="server_id"/>
                <filter string="Available" name="available" domain="[('available', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Start Format" name="group_by_start_format" context="{'group_by': 'start_format'}"/>
                    <filter string="End Format" name="group_by_end_format" context="{'group_by': 'end_format'}"/>
                    <filter string="CAD Name" name="group_by_cad_name" context="{'group_by': 'cad_name'}"/>
                    <filter string="Server" name="group_by_server" context="{'group_by': 'server_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for the menu -->
    <record id="plm_convert_format_action" model="ir.actions.act_window">
        <field name="name">Convert Formats</field>
        <field name="res_model">plm.convert.format</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="plm_convert_format_list_view"/>
        <field name="search_view_id" ref="plm_convert_format_search_view"/>
    </record>

    <!-- Menu Item -->
    <menuitem id="plm_convert_format_menu"
              name="Convert Formats"
              parent="plm.plm_menu_dictionaries"
              groups="plm_automated_convertion.group_plm_convert_view"
              action="plm_convert_format_action"
              sequence="10"/>
</odoo>
