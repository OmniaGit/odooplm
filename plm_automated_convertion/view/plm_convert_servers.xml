<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record model="ir.ui.view" id="plm_convert_servers_search">
            <field name="name">plm.convert.servers.search</field>
            <field name="model">plm.convert.servers</field>
            <field name="priority" eval="1" />
            <field name="arch" type="xml">
                <search string="Plm Convert Servers">
                    <field name="name" />
                    <field name="address" />
                    <field name="protocol" />
                    <field name="port" />
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="plm_convert_servers_form">
            <field name="name">plm.convert.servers.form</field>
            <field name="model">plm.convert.servers</field>
            <field name="arch" type="xml">
                <form string="Plm Convert Servers">
                    <sheet>
                        <group>
                            <field name="sequence" />
                            <field name="available" widget="boolean_toggle" />
                            <field name="name" required="True" />
                            <field name="is_internal" />
                        </group>
                        <group name="workstation" string="CAD Workstation" invisible="not workstation_guid">
                            <group>
                                <field name="alive" />
                                <field name="last_contact" />
                                <field name="hostname" />
                                <field name="agent_version" />
                                <field name="workstation_guid" />
                            </group>
                            <group>
                                <field name="group_ids" widget="many2many_tags" />
                                <field name="features" />
                                <field name="work_hours" />
                            </group>
                            <field name="workstation_cad_ids" colspan="2" nolabel="1">
                                <list>
                                    <field name="cad_name" />
                                    <field name="cad_version" />
                                    <field name="prog_id" optional="hide" />
                                </list>
                            </field>
                        </group>
                        <group name="server_spec" invisible="is_internal==True or workstation_guid">
                            <field
                                name="folder_to"
                                placeholder="my_shared_folder_path"
                            />
                            <field
                                name="address"
                                placeholder="127.0.0.1"
                                required="is_internal==False and not workstation_guid"
                            />
                            <field
                                name="protocol"
                                placeholder="http"
                                required="is_internal==False and not workstation_guid"
                            />
                            <field
                                name="port"
                                placeholder="5000"
                                required="is_internal==False and not workstation_guid"
                            />
                            <field name="timeout" />
                            <button name="testConnection" type="object" string="Test" />
                        </group>
                        <group
                            invisible="is_internal==True or workstation_guid or client_processes in [False, '']"
                        >
                            <field name="proc_to_kill" colspan="1" />
                            <button name='killProcess' type="object" string="Kill" />
                        </group>
                        <group invisible="is_internal==True or workstation_guid">
                            <button
                                name='getClientProcesses'
                                type="object"
                                string="Get Client Processes"
                                colspan="4"
                            />
                            <field
                                name="client_processes"
                                readonly="True"
                                colspan="4"
                                nolabel="1"
                            />
                        </group>
                        <field name="available_format">
                            <list>
                                <field name="available" widget="boolean_toggle" />
                                <field name="name" />
                                <field name="sequence" />
                                <field name="start_format" />
                                <field name="end_format" />
                                <field name="presented" optional="hide" />
                                <field name="cad_name" />
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="plm_convert_servers_list">
            <field name="name">plm.convert.servers.list</field>
            <field name="model">plm.convert.servers</field>
            <field name="priority" eval="1" />
            <field name="arch" type="xml">
                <list string="Plm Convert Servers">
                    <field name="sequence" widget="handle" />
                    <field name="name" />
                    <field name="available" widget="boolean_toggle" />
                    <field name="hostname" optional="show" />
                    <field name="alive" optional="show" />
                    <field name="last_contact" optional="show" />
                    <field name="agent_version" optional="hide" />
                    <field name="group_ids" widget="many2many_tags" optional="show" />
                    <field name="address" optional="hide" />
                    <field name="protocol" optional="hide" />
                    <field name="port" optional="hide" />
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="plm_convert_servers_action">
            <field name="name">Plm Convert Servers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">plm.convert.servers</field>
            <field name="view_id" ref="plm_convert_servers_list" />
            <field name="search_view_id" ref="plm_convert_servers_search" />
        </record>

        <menuitem
            id="plm_convert_servers_menu"
            name="Workstations and Servers"
            parent="menu_cad_conversion"
            sequence="10"
            groups="plm_automated_convertion.group_plm_convert_view"
            action="plm_convert_servers_action"
        />

    </data>
</odoo>
