<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_plm_convert_view" model="res.groups">
        <field name="name">Plm Convert View</field>
        <field name="privilege_id" ref="plm.res_groups_privilege_odooplm"/>
    </record>

    <record id="group_plm_convert_admin" model="res.groups">
        <field name="name">Plm Convert Admin</field>
        <field name="privilege_id" ref="plm.res_groups_privilege_odooplm"/>
        <field name="implied_ids" eval="[(4, ref('group_plm_convert_view'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
     </record>

    <record id="plm_convert_rule_admin" model="ir.access">
        <field name="name">Plm Convert Rule Admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_rule"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin"/>
        <field name="operation">crud</field>
    </record>

    <record id="plm_convert_stack_admin" model="ir.access">
        <field name="name">Plm Convert Stack Admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_stack"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin"/>
        <field name="operation">crud</field>
    </record>

    <record id="plm_convert_servers_admin" model="ir.access">
        <field name="name">Plm Convert Servers Admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_servers"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin"/>
        <field name="operation">crud</field>
    </record>

    <record id="plm_convert_rule_user" model="ir.access">
        <field name="name">Plm Convert Rule User</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_rule"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view"/>
        <!-- Rules carry the evaluated output_name_rule; creating them is admin
             configuration only, so view users get read-only access. -->
        <field name="operation">r</field>
    </record>

    <record id="plm_convert_stack_user" model="ir.access">
        <field name="name">Plm Convert Stack User</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_stack"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view"/>
        <field name="operation">cr</field>
    </record>

    <record id="plm_convert_servers_user" model="ir.access">
        <field name="name">Plm Convert Servers User</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_servers"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view"/>
        <field name="operation">r</field>
    </record>

    <record id="plm_convert_user" model="ir.access">
        <field name="name">Plm Convert Wizard</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view"/>
        <field name="operation">crud</field>
    </record>

    <record id="plm_convert_format_user" model="ir.access">
        <field name="name">Plm Convert Wizard</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_format"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view"/>
        <field name="operation">ru</field>
    </record>
    <!-- the conversion rules of a server are made in Odoo by a Plm Convert
         Admin (the workstations make their own when they register) -->
    <record id="plm_convert_format_admin" model="ir.access">
        <field name="name">Plm Convert Format Admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_format"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin"/>
        <field name="operation">crud</field>
    </record>
    <record id="plm_convert_servers_template_wizard_admin" model="ir.access">
        <field name="name">Add Conversions From A Template</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_servers_template_wizard"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin"/>
        <field name="operation">crud</field>
    </record>

    <record id="plm_convert_servers_cad_admin" model="ir.access">
        <field name="name">Plm Convert Servers CAD Admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_servers_cad"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin"/>
        <field name="operation">crud</field>
    </record>

    <record id="plm_convert_servers_cad_user" model="ir.access">
        <field name="name">Plm Convert Servers CAD User</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_servers_cad"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view"/>
        <field name="operation">r</field>
    </record>

    <record id="plm_cad_version_queue_wizard_admin" model="ir.access">
        <field name="name">Massive Update Admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_cad_version_queue_wizard"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin"/>
        <field name="operation">crud</field>
    </record>

    <!-- Conversion templates (Odoo 20: an access with a domain allows only the
         records in it). A user reads the predefined templates (no owner) and
         his own, and creates, changes and deletes only his own; a Plm Convert
         Admin does everything. -->
    <record id="plm_convert_template_user" model="ir.access">
        <field name="name">Plm Convert Template: read the predefined and own</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view"/>
        <field name="operation">r</field>
        <field name="domain">['|', ('owner_id', '=', False), ('owner_id', '=', user.id)]</field>
    </record>
    <record id="plm_convert_template_user_own" model="ir.access">
        <field name="name">Plm Convert Template: change the own</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view"/>
        <field name="operation">cud</field>
        <field name="domain">[('owner_id', '=', user.id)]</field>
    </record>
    <record id="plm_convert_template_admin" model="ir.access">
        <field name="name">Plm Convert Template Admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin"/>
        <field name="operation">crud</field>
    </record>
    <record id="plm_convert_template_line_user" model="ir.access">
        <field name="name">Plm Convert Template Line: read the predefined and own</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template_line"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view"/>
        <field name="operation">r</field>
        <field name="domain">['|', ('template_id.owner_id', '=', False), ('template_id.owner_id', '=', user.id)]</field>
    </record>
    <record id="plm_convert_template_line_user_own" model="ir.access">
        <field name="name">Plm Convert Template Line: change the own</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template_line"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view"/>
        <field name="operation">cud</field>
        <field name="domain">[('template_id.owner_id', '=', user.id)]</field>
    </record>
    <record id="plm_convert_template_line_admin" model="ir.access">
        <field name="name">Plm Convert Template Line Admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template_line"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin"/>
        <field name="operation">crud</field>
    </record>
    <!-- the lines of the conversion wizard -->
    <record id="plm_convert_line_user" model="ir.access">
        <field name="name">Plm Convert Wizard Line</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_line"/>
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view"/>
        <field name="operation">crud</field>
    </record>

</odoo>
