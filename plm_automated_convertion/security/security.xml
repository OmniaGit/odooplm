<?xml version="1.0" encoding="utf-8" ?>
<odoo>


    <record id="group_plm_convert_view" model="res.groups">
        <field name="name">Plm Convert View</field>
        <field name="category_id" ref="plm.odooplm_module_category" />
    </record>

    <record id="group_plm_convert_admin" model="res.groups">
        <field name="name">Plm Convert Admin</field>
        <field name="category_id" ref="plm.odooplm_module_category" />
        <field name="implied_ids" eval="[(4, ref('group_plm_convert_view'))]" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
     </record>

    <record id="plm_convert_rule_admin" model="ir.model.access">
        <field name="name">Plm Convert Rule Admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_rule" />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="plm_convert_stack_admin" model="ir.model.access">
        <field name="name">Plm Convert Stack Admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_stack" />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="plm_convert_servers_admin" model="ir.model.access">
        <field name="name">Plm Convert Servers Admin</field>
        <field
            name="model_id"
            ref="plm_automated_convertion.model_plm_convert_servers"
        />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="plm_convert_rule_user" model="ir.model.access">
        <field name="name">Plm Convert Rule User</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_rule" />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <!-- Rules carry the evaluated output_name_rule; creating them is admin
             configuration only, so view users get read-only access. -->
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="plm_convert_stack_user" model="ir.model.access">
        <field name="name">Plm Convert Stack User</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_stack" />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="plm_cad_version_queue_wizard_admin" model="ir.model.access">
        <field name="name">Massive Update Admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_cad_version_queue_wizard" />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="plm_convert_servers_cad_admin" model="ir.model.access">
        <field name="name">Plm Convert Servers CAD Admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_servers_cad" />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="plm_convert_servers_cad_user" model="ir.model.access">
        <field name="name">Plm Convert Servers CAD User</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_servers_cad" />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="plm_convert_servers_user" model="ir.model.access">
        <field name="name">Plm Convert Servers User</field>
        <field
            name="model_id"
            ref="plm_automated_convertion.model_plm_convert_servers"
        />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="plm_convert_user" model="ir.model.access">
        <field name="name">Plm Convert Wizard</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert" />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="plm_convert_format_user" model="ir.model.access">
        <field name="name">Plm Convert Wizard</field>
        <field
            name="model_id"
            ref="plm_automated_convertion.model_plm_convert_format"
        />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>
    <!-- the conversion rules of a server are made in Odoo by a Plm Convert
         Admin (the workstations make their own when they register) -->
    <record id="plm_convert_format_admin" model="ir.model.access">
        <field name="name">Plm Convert Format Admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_format" />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
    <record id="plm_convert_servers_template_wizard_admin" model="ir.model.access">
        <field name="name">Add Conversions From A Template</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_servers_template_wizard" />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>


    <record id="plm_convert_template_user" model="ir.model.access">
        <field name="name">Conversion Template User</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template" />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
    <record id="plm_convert_template_admin" model="ir.model.access">
        <field name="name">Conversion Template Admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template" />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
    <record id="plm_convert_template_line_user" model="ir.model.access">
        <field name="name">Conversion Template Line User</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template_line" />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
    <record id="plm_convert_template_line_admin" model="ir.model.access">
        <field name="name">Conversion Template Line Admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template_line" />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_admin" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
    <record id="plm_convert_line_user" model="ir.model.access">
        <field name="name">Conversion Wizard Line User</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_line" />
        <field name="group_id" ref="plm_automated_convertion.group_plm_convert_view" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <!-- a user reads the predefined templates and his own, and changes only his own;
         a Plm Convert Admin manages them all -->
    <record id="plm_convert_template_rule_user" model="ir.rule">
        <field name="name">Conversion templates: predefined and own</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template" />
        <field name="groups" eval="[(4, ref('plm_automated_convertion.group_plm_convert_view'))]" />
        <field name="domain_force">['|', ('owner_id', '=', False), ('owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>
    <record id="plm_convert_template_rule_user_own" model="ir.rule">
        <field name="name">Conversion templates: change only own</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template" />
        <field name="groups" eval="[(4, ref('plm_automated_convertion.group_plm_convert_view'))]" />
        <field name="domain_force">[('owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="0" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
    <record id="plm_convert_template_line_rule_user" model="ir.rule">
        <field name="name">Conversion template lines: predefined and own</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template_line" />
        <field name="groups" eval="[(4, ref('plm_automated_convertion.group_plm_convert_view'))]" />
        <field name="domain_force">['|', ('template_id.owner_id', '=', False), ('template_id.owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>
    <record id="plm_convert_template_line_rule_user_own" model="ir.rule">
        <field name="name">Conversion template lines: change only own</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template_line" />
        <field name="groups" eval="[(4, ref('plm_automated_convertion.group_plm_convert_view'))]" />
        <field name="domain_force">[('template_id.owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="0" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
    <record id="plm_convert_template_rule_admin" model="ir.rule">
        <field name="name">Conversion templates: all for the admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template" />
        <field name="groups" eval="[(4, ref('plm_automated_convertion.group_plm_convert_admin'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="plm_convert_template_line_rule_admin" model="ir.rule">
        <field name="name">Conversion template lines: all for the admin</field>
        <field name="model_id" ref="plm_automated_convertion.model_plm_convert_template_line" />
        <field name="groups" eval="[(4, ref('plm_automated_convertion.group_plm_convert_admin'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
