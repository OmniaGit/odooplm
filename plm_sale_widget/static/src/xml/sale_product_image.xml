<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="plm_sale_widget.PlmSaleProductImage"
        t-inherit="plm.PlmProductImage"
        t-inherit-mode="primary"
    >
        <!-- a click here never reaches the row (no line in edition) -->
        <xpath expr="//span[hasclass('plm_m2o_avatar')]" position="attributes">
            <attribute name="t-on-click.stop">() => {}</attribute>
        </xpath>
        <xpath expr="//span[hasclass('plm_product_image')]" position="attributes">
            <attribute name="style">cursor:default;</attribute>
        </xpath>
        <xpath expr="//span[hasclass('plm_product_image')]" position="after">
            <t t-foreach="buttons" t-as="button" t-key="button.kind">
                <button
                    t-if="button.documents.length === 1"
                    type="button"
                    class="btn btn-sm btn-link px-1 py-0 text-nowrap"
                    t-att-title="button.title"
                    t-on-click="() => this.openDocument(button.kind, button.documents[0])"
                >
                    <i t-att-class="button.icon" /> <t t-esc="button.label" />
                </button>
                <Dropdown t-elif="button.documents.length">
                    <button
                        type="button"
                        class="btn btn-sm btn-link px-1 py-0 text-nowrap"
                        t-att-title="button.title"
                    >
                        <i t-att-class="button.icon" /> <t t-esc="button.label" />
                        <i class="fa fa-caret-down ms-1" />
                    </button>
                    <t t-set-slot="content">
                        <DropdownItem
                            t-foreach="button.documents"
                            t-as="document"
                            t-key="document.id"
                            onSelected="() => this.openDocument(button.kind, document)"
                        >
                            <t t-esc="document.name" />
                        </DropdownItem>
                    </t>
                </Dropdown>
            </t>
        </xpath>
    </t>
</templates>
