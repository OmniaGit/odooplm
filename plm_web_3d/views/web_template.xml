<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="plm_web_3d.main_treejs_view">
        <html>
            <head>
                <meta charset="utf-8"></meta>
                <meta name="viewport"
                      content="width=device-width, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0"></meta>
                <title>OdooPLM WebGl View</title>
                <script type="importmap">
                    {"imports": {
                    "three": "../plm_web_3d/static/src/js/lib/three.js/build/three.module.js"
                    }
                    }
                </script>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.0/fabric.min.js"></script>
                <script type="text/javascript" src="/plm_web_3d/static/src/js/markup_system.js"/>
                <script type="module">
                    import { tweenCamera,camera } from "../plm_web_3d/static/src/js/OdooCADApplication.js";
                    window.tweenCamera = tweenCamera;
                    window.camera = camera;
                </script>

                <link rel="stylesheet" type="text/css"
                      href="../plm_web_3d/static/src/css/OdooCADApplication.css"></link>
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"></link>
            </head>

            <body style="margin: 0;">
                <div id="main_3d_web"
                     class="viewer_container"
                     t-att-data-res-id="document_id"
                     data-res-model="ir.attachment"
                     t-att-data-file-name="document_name">

                    <span id="active_model" t-att-active_model="document_id" t-att-document_name="document_name"></span>
                    <div id="odoo_plm_title">
                        <a href="https://odooplm.omniasolutions.website/" id="hiper_odooplm">
                            <img src="../plm_web_3d/static/src/img/odoo_plm_2019x300.png" alt="OdooPLM"
                                 class="header_image"/>
                        </a>
                        <a href="https://threejs.org/" id="hiper_treejs">
                            <img src="../plm_web_3d/static/src/img/threejs_logo.png" alt="ThreeJs"
                                 class="header_image"/>
                        </a>
                        <div id="progress">
                            <div id="progress_bar"/>
                        </div>
                    </div>
                    <div class='main_command_slide' id="mainCommandSlide">
                        <div class='activator'>
                            <div class="img" id="activatorClick">
                                <hr class="hover_line"/>
                                <hr class="hover_line"/>
                                <hr class="hover_line"/>
                            </div>
                        </div>

                        <div id="dropdown_menu_left_permenant">
                            <div class="plm_button_per" id="fit_view_perm">
                                <i class="fa fa-home"></i>
                            </div>
                            <div class="plm_button_per" id="save_view_perm">
                                <i class="fa fa-save"></i>
                            </div>
                            <div class="plm_button_per" id="markup_button_perm">
                                <i class="fa fa-edit"></i>
                            </div>
                        </div>

                        <div class="activatorDiv d-none" id="activatorDiv">
                            <div id="dropdown_menu_left">
                                <div class="plm_button" id="fit_view"><i class="fa fa-home"></i>Fit
                                </div>
                                <div class="plm_button" id="save_view"><i class="fa fa-save"></i>Save
                                </div>
                                <div class="plm_button" id="markup_button"><i class="fa fa-edit"></i>Markup
                                </div>
                                <div class="plm_button">
                                    <label for="webgl_background">BackGround:</label>
                                    <select name="webgl_background" id="webgl_background">
                                        <option value="tecnical">Tecnical</option>
                                        <option value="room1">Room 1</option>
                                        <option value="room2">Room 2</option>
                                        <option value="outdoor">Outdoor 1</option>
                                        <option value="workshop1">WorkShop 1</option>
                                        <option value="workshop2">WorkShop 2</option>
                                        <option value="workshop3">WorkShop 3</option>
                                    </select>
                                </div>
                                <div class="plm_button" id="toggle_light_settings" style="cursor:pointer;">
                                    <b>▶ Light Settings</b>
                                </div>
                                <div class="plm_button" id="light_settings_group"
                                     style="display:none; padding-left:10px;">
                                    <div>
                                        <label>Light Distance:</label>
                                        <input id="object_distance" type="range" min="1" max="1000" value="15"/>
                                    </div>
                                    <div>
                                        <label>Light1:</label>
                                        <input id="object_light1" type="range" min="1" max="100" value="50"/>
                                    </div>
                                    <div>
                                        <label>Light2:</label>
                                        <input id="object_light2" type="range" min="1" max="100" value="50"/>
                                    </div>
                                    <div>
                                        <label>Light3:</label>
                                        <input id="object_light3" type="range" min="1" max="100" value="50"/>
                                    </div>
                                    <div>
                                        <label>Camera Light:</label>
                                        <input id="object_light_camera" type="range" min="1" max="100" value="50"/>
                                    </div>
                                    <div>
                                        <label>Ambient Light:</label>
                                        <input id="object_light_ambient" type="range" min="1" max="100" value="50"/>
                                    </div>
                                </div>
                                <div class="plm_button">
                                    <label for="transparency_slider">Transparency:</label>
                                    <input name="transparency_slider" id="object_transparency" type="range" min="0"
                                           max="100" value="90"/>
                                </div>
                                <div class="plm_button">
                                    <div id="color_object_grp">
                                        <label for="object_color">Color:</label>
                                        <input type="color" id="object_color" name="object_color" value="#b2ffc8"/>
                                    </div>
                                </div>

                                <div id="plm_button1">
                                    <label for="explosion_slider">Explosion:</label>
                                    <input name="explosion_slider" id="object_explosion" type="range" min="0" max="100"
                                           value="0"/>
                                </div>

                                <div class="info_header">
                                    <b>Markup Logs</b>
                                </div>
                                <hr class="datacard_line"/>
                                <div id="markup_logs_list" style="direction:ltr; text-align:left; padding:4px;">
                                    <small style="color:gray;">No logs yet.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="viewer_container">
                        <canvas id="odoo_canvas"></canvas>

                        <div id="markup_editor">
                            <div id="markup_toolbar">
                                <button id="draw_btn">✏️ Draw</button>
                                <button id="rect_btn">▭ Rect</button>
                                <button id="circle_btn">◯ Circle</button>
                                <button id="arrow_btn">➤ Arrow</button>
                                <button id="text_btn">T Text</button>
                                <button id="delete_btn">🗑️ Remove</button>
                                <button id="clear_btn">🧹 Clear</button>
                                <button id="undo_btn">↩️ Undo</button>
                                <button id="redo_btn">↪️ Redo</button>
                                <button id="close_btn">✖ Close</button>
                            </div>
                            <canvas id="markup_canvas"></canvas>
                            <div id="markup_comment_box">
                                <div id="activity_form_panel"
                                     style="display:none; padding:8px; border-top:1px solid #555; margin-top:4px;">
                                    <div style="margin-bottom:6px;">
                                        <label style="display:block; font-size:11px; margin-bottom:2px; color:black;">
                                            Due
                                            Date
                                        </label>
                                        <input type="date" id="activity_due_date"
                                               style="width:100%; padding:4px; box-sizing:border-box; background:#2d2d2d; color:#fff; border:1px solid #555; border-radius:3px;"/>
                                    </div>
                                    <div style="margin-bottom:6px;">
                                        <label style="display:block; font-size:11px; margin-bottom:2px; color:black;">
                                            Summary
                                        </label>
                                        <input type="text" id="activity_summary" placeholder="Summary"
                                               style="width:100%; padding:4px; box-sizing:border-box; background:#2d2d2d; color:#fff; border:1px solid #555; border-radius:3px;"/>
                                    </div>
                                    <div style="margin-bottom:6px;">
                                        <label style="display:block; font-size:11px; margin-bottom:2px; color:black;">
                                            Assigned To
                                        </label>
                                        <select id="activity_user_id"
                                                style="width:100%; padding:4px; box-sizing:border-box; background:#2d2d2d; color:#fff; border:1px solid #555; border-radius:3px;">
                                            <option value="">Loading users...</option>
                                        </select>
                                    </div>
                                    <div id="activity_msg"
                                         style="display:none; margin-top:6px; font-size:11px; text-align:center;">
                                    </div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <textarea id="markup_comment" placeholder="Write Message..."></textarea>
                                    <div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
                                        <label>
                                            <input type="checkbox" id="activity_view"/>
                                            Activity
                                        </label>
                                        <button id="submit_markup">Submit</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="datasheet">
                        <div id="click_show" class="click_show">
                            <hr class="hover_line"/>
                            <hr class="hover_line"/>
                            <hr class="hover_line"/>
                        </div>
                        <div id="main_div">
                            <div id="main_div_hidden">
                                <div class="info_header">
                                    <b>Product Information</b>
                                </div>
                                <hr class="datacard_line"/>
                                <lu id="product_info">
                                </lu>


                                <div class="info_header">
                                    <b>Document Information</b>
                                </div>
                                <hr class="datacard_line"/>
                                <lu id="document_info">
                                </lu>

                                <div class="info_header">
                                    <b>Document Structure</b>
                                </div>
                                <hr class="datacard_line"/>
                                <div class="search_document_list">
                                    <input type="text" id="input_search_document_list" placeholder="Search Here !!"/>
                                    <button type="button" id="hide_all_parts" title="Hide"
                                            class="fa fa-moon-o"></button>
                                    <button type="button" id="show_all_parts" title="Un-Hide"
                                            class="fa fa-lightbulb-o"></button>
                                </div>
                                <lu id="document_tree">
                                </lu>

                            </div>
                        </div>
                    </div>
                    <ViewCubeContainer>
                        <div class='cube'>
                            <div
                                class='cube__face cube__face--front'
                                onClick="window.tweenCamera('FRONT')"
                            >
                                front
                            </div>
                            <div
                                class='cube__face cube__face--back'
                                onClick="window.tweenCamera('BACK')"
                            >
                                back
                            </div>
                            <div
                                class='cube__face cube__face--right'
                                onClick="window.tweenCamera('RIGHT')"
                            >
                                right
                            </div>
                            <div
                                class='cube__face cube__face--left'
                                onClick="window.tweenCamera('LEFT')"
                            >
                                left
                            </div>
                            <div
                                class='cube__face cube__face--top'
                                onClick="window.tweenCamera('TOP')"
                            >
                                top
                            </div>
                            <div
                                class='cube__face cube__face--bottom'
                                onClick="window.tweenCamera('BOTTOM')"
                            >
                                bottom
                            </div>
                        </div>
                    </ViewCubeContainer>
                </div>
                <div id="markup_log_modal">
                    <div id="markup_log_modal_inner">
                        <span id="markup_log_modal_close">✖</span>
                        <div id="markup_log_modal_date" style="font-weight:bold; color:#714B67;"></div>
                        <img id="markup_log_modal_img" src="" alt="Markup Screenshot"/>
                        <div id="markup_log_modal_comment"></div>
                    </div>
                </div>

                <!-- ESC Confirm Modal -->
                <div id="markup_esc_modal"
                     style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:99999; justify-content:center; align-items:center;">
                    <div
                        style="background:white; border-radius:10px; border:2px solid #714B67; padding:24px 28px; min-width:280px; text-align:center; box-shadow:0 4px 20px rgba(0,0,0,0.3);">
                        <span id="markup_log_modal_close2">✖</span>
                        <div style="font-size:15px; font-weight:bold; color:#572649; margin-bottom:18px;">Are you sure
                            you want to close?
                        </div>
                        <div style="display:flex; justify-content:center; gap:12px;">
                            <button id="markup_esc_save" class="mcr-submit" style="min-width:80px;">Save</button>
                            <button id="markup_esc_close" class="mcr-btn" style="min-width:80px;">Close</button>
                        </div>
                    </div>
                </div>
                <div id="part_tooltip"
                     style="display:none; position:fixed; background:rgba(0,0,0,0.85); color:white; padding:6px 12px; border-radius:5px; z-index:2000; pointer-events:none; font-size:13px; border: 1px solid #714B67; box-shadow: 0 4px 15px rgba(0,0,0,0.3); font-weight: 600; white-space: nowrap;"></div>
            </body>
        </html>
    </template>
</odoo>
