<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_plm_material_web3d">
        <field name="name">plm.material.view.web3d</field>
        <field name="model">plm.material</field>
        <field name="inherit_id" ref="plm.view_plm_material"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="3D Appearance" name="web3d_appearance">
                    <group>
                        <field name="web3d_color" widget="color"/>
                        <field name="web3d_metalness"/>
                        <field name="web3d_roughness"/>
                        <field name="web3d_opacity"/>
                    </group>
                    <group>
                        <field name="web3d_texture" widget="image" class="oe_avatar"/>
                        <field name="web3d_texture_size"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
