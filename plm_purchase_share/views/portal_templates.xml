<odoo>
    <template
        id="plm_purchase_order_portal_content"
        inherit_id="purchase.purchase_order_portal_content"
        active="True"
    >
        <xpath
            expr="//section[@id='details']//table[@id='purchase_order_table']//thead//tr//th[hasclass('text-start')]"
            position="after"
        >
            <th>
            </th>
        </xpath>
        <xpath
            expr="//section[@id='details']//table[@id='purchase_order_table']//tbody//td[@id='product_name']"
            position="after"
        >
            <t
                t-set="doc"
                t-value="line.product_id.linkeddocuments.filtered(lambda a: a.document_type == '2d')[:1]"
            />
            <t t-if="doc.engineering_state in ['released', 'undermodify']">
            <td id="single_product_download">
                <t
                    t-if="doc and request.env.user.has_group('plm_purchase_share.group_plm_purchase_portal_user')"
                >
                    <a
                        t-att-href="'/report/html/plm.product_production_pdf_latest/%s' % line.product_id.id"
                        class="btn btn-primary"
                        style="width:50px; height:40px;"
                        target="_blank"
                    >
                        <i class="fa fa-download" />
                    </a>
                </t>
            </td>
            </t>
            <t t-else="">
	            <td id="single_product_download" title="Document not already released">
	                <i class="fa fa-ban" style="color: red; font-weight: bold;" />
	            </td>
            </t>
        </xpath>
    </template>

    <template
        id="plm_portal_my_purchase_order"
        inherit_id="purchase.portal_my_purchase_order"
        active="True"
    >
        <xpath expr="//a[@id='print_invoice_report']" position="after">
            <t
                t-if="request.env.user.has_group('plm_purchase_share.group_plm_purchase_portal_user')"
            >
                <a
                    id="all_product_download"
                    class="btn btn-primary"
                    t-att-href="'/my/purchase/%s/download_docs' % order.id"
                    target="_blank"
                >
                    <i class="fa fa-download" />
                    Download Documents
                </a>
            </t>
        </xpath>
    </template>

</odoo>
