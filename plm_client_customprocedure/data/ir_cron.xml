<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Cron to auto create cad file stack record-->
        <record id="ir_cron_auto_create_cad_file_stack" model="ir.cron">
            <field name="name">Auto create plm convert stack record</field>
            <field name="model_id" ref="model_product_product"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_create_plm_convert_stack()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="convert_documents_cron" model="ir.cron">
            <field name="name">Convert Documents</field>
            <field name="active" eval="False"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="model_plm_convert_stack"/>
            <field name="code">env['plm.convert.stack'].generateConvertedDocuments()</field>
            <field name="state">code</field>
        </record>

    </data>
</odoo>
