<odoo>
    <record id="plm_convert_stack_form_inherit" model="ir.ui.view">
        <field name="name">plm.convert.stack.form.inherit.add.notebook</field>
        <field name="model">plm.convert.stack</field>
        <field name="inherit_id" ref="plm_automated_convertion.plm_convert_stack_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[field[@name='error_string']]" position="before">
                <notebook>
                    <page string="Update Details">
                        <field name="conversion_line_ids" readonly="state == 'done'">
                            <list editable="bottom">
                                <field name="model_id"/>
                                <field name="field_id"/>
                                <field name="cad_field"/>
                                <field name="old_value"/>
                                <field name="new_value"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
