<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Every PLM sequence is global (company_id False): one counter shared by
         all the companies. ir.sequence would otherwise take env.company at
         install, and next_by_code returns False in any other company. A company
         that needs its own numbering gets its own copy of the sequence, which
         next_by_code prefers to the global one. Existing databases are brought
         in line by upgrades/19.0.1.0.30/post-migrate.py, since these records
         are noupdate. -->

    <data noupdate="1">
        <!-- Sequences for plm.finishing -->
        <record id="seq_plm_finishing" model="ir.sequence">
            <field name="name">PLM Finishing Sequence</field>
            <field name="code">plm.finishing</field>
            <field name="company_id" eval="False"/>
            <field name="prefix">SF</field>
            <field name="padding">5</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- Sequences for plm.material -->
        <record id="seq_plm_description" model="ir.sequence">
            <field name="name">PLM description Sequence</field>
            <field name="code">plm.description</field>
            <field name="company_id" eval="False"/>
            <field name="prefix">DS</field>
            <field name="padding">5</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- Sequences for plm.treatment -->
        <record id="seq_plm_treatment" model="ir.sequence">
            <field name="name">PLM Treatment Sequence</field>
            <field name="code">plm.treatment</field>
            <field name="company_id" eval="False"/>
            <field name="prefix">TT</field>
            <field name="padding">5</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- Sequences for plm.material -->
        <record id="seq_plm_material" model="ir.sequence">
            <field name="name">PLM Material Sequence</field>
            <field name="code">plm.material</field>
            <field name="company_id" eval="False"/>
            <field name="prefix">RM</field>
            <field name="padding">5</field>
        </record>
    </data>

	<data noupdate="1">
        <record id="sequence_document" model="ir.sequence">
            <field name="name">Document Sequence</field>
            <field eval="6" name="padding"/>
            <field name="code">ir.attachment.progress</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="sequence_plm_dbthread" model="ir.sequence">
            <field name="name">db Thread sequence</field>
            <field eval="6" name="padding"/>
            <field name="code">plm.dbthread.progress</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

</odoo>
