<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add the per-language report Unit of Measure configuration on the
         language form (Settings > Translations > Languages). -->
    <record id="res_lang_form_plm_uom" model="ir.ui.view">
        <field name="name">res.lang.form.plm.report.uom</field>
        <field name="model">res.lang</field>
        <field name="inherit_id" ref="base.res_lang_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Report Units of Measure">
                    <field name="plm_report_uom_default"/>
                    <field name="plm_report_uom_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="category_id"/>
                            <field name="uom_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
