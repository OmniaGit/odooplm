<!-- ir.attachment  -->
    <record id="plm_ir_attachment_view" model="ir.access">
        <field name="name">PLM Document</field>
        <field name="model_id" ref="model_ir_attachment"/>
        <field name="group_id" ref="group_plm_view_user"/>
        <field name="operation">r</field>
    </record>
    <record id="plm_ir_attachment_integration" model="ir.access">
        <field name="name">PLM Document</field>
        <field name="model_id" ref="model_ir_attachment"/>
        <field name="group_id" ref="group_plm_integration_user"/>
        <field name="operation">cru</field>
    </record>
    <record id="plm_ir_attachment_admin" model="ir.access">
        <field name="name">PLM Document</field>
        <field name="model_id" ref="model_ir_attachment"/>
        <field name="group_id" ref="group_plm_admin"/>
        <field name="operation">crud</field>
    </record>

    <record id="group_plm_readonly_released_rule_document" model="ir.access">
        <field name="name">NoWrite / NoDelete PLM Document Released</field>
        <field name="model_id" ref="model_ir_attachment"/>
        <field name="group_id" ref="group_plm_readonly_released"/>
        <field name="operation">d</field>
        <field name="domain">[('engineering_state','not in',['draft', False]), ('is_plm','=', True)]</field>
    </record>

    <!-- Level 2, readonly: PLM documents, read only. -->
    <record id="group_plm_view_plm_document" model="ir.access">
        <field name="name">View only plm Documnet</field>
        <field name="model_id" ref="model_ir_attachment"/>
        <field name="group_id" ref="group_plm_view_user"/>
        <field name="operation">r</field>
        <field name="domain">[('is_plm','=',True)]</field>
    </record>

    <!-- Level 3, integration: reads, writes and creates every PLM document.
         Deleting is the next rule: only its own drafts. -->
    <record id="group_plm_admin_plm_document" model="ir.access">
        <field name="name">Integration rule PLM documnet</field>
        <field name="model_id" ref="model_ir_attachment"/>
        <field name="group_id" ref="group_plm_integration_user"/>
        <field name="operation">cru</field>
        <field name="domain">[('is_plm','=',True)]</field>
    </record>

    <!-- Level 1, readonly state: the documents it reads are the released and
         under modification ones. A global rule, because a group rule can only
         grant: it is written to leave every other PLM level untouched. -->
    <record id="plm_readonly_state_ir_attachment" model="ir.access">
        <field name="name">PLM readonly state: document</field>
        <field name="model_id" ref="model_ir_attachment"/>
        <field name="operation">r</field>
        <field name="domain">['|', ('is_plm', '=', False), ('engineering_state', 'in', ['released', 'undermodify'])] if user.has_group('plm.group_plm_readonly_released') and not user.has_group('plm.group_plm_integration_user') else []</field>
    </record>

    <!-- Level 3, integration: deletes only its own documents, and only while
         they are draft. -->
    <record id="plm_integration_unlink_ir_attachment" model="ir.access">
        <field name="name">PLM integration deletes its own drafts: document</field>
        <field name="model_id" ref="model_ir_attachment"/>
        <field name="group_id" ref="group_plm_integration_user"/>
        <field name="operation">d</field>
        <field name="domain">[('is_plm', '=', True), ('engineering_state', 'in', ['draft', False]), ('create_uid', '=', user.id)]</field>
    </record>

    <!-- Level 4, admin: every document, deleting included. -->
    <record id="plm_admin_ir_attachment" model="ir.access">
        <field name="name">PLM admin: document</field>
        <field name="model_id" ref="model_ir_attachment"/>
        <field name="group_id" ref="group_plm_admin"/>
        <field name="operation">crud</field>
        <field name="domain">[('is_plm', '=', True)]</field>
    </record>

    <!-- An internal user outside the PLM groups keeps every attachment that is
         not a PLM document, and none that is. Permissions are OR-ed, so a PLM
         user adds the PLM accesses above to this one. -->
    <record id="plm_base_user_non_plm_document" model="ir.access">
        <field name="name">Non-PLM attachments only</field>
        <field name="model_id" ref="model_ir_attachment"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="operation">crud</field>
        <field name="domain">[('is_plm', '=', False)]</field>
    </record>

    <!-- Create and unlink on a document are decided by the groups of its PLM
         access node. Read and write are too, but Odoo checks those on the node
         itself, the document's res record (see the plm.access rules). -->
    <record id="plm_access_document_create" model="ir.access">
        <field name="name">PLM access: create documents</field>
        <field name="model_id" ref="model_ir_attachment"/>
        <field name="operation">c</field>
        <field name="domain">['|', ('plm_access_id', '=', False), '|', ('plm_access_id.effective_create_group_ids', '=', False), ('plm_access_id.effective_create_group_ids', 'in', user.all_group_ids.ids)]</field>
    </record>

    <record id="plm_access_document_unlink" model="ir.access">
        <field name="name">PLM access: delete documents</field>
        <field name="model_id" ref="model_ir_attachment"/>
        <field name="operation">d</field>
        <field name="domain">['|', ('plm_access_id', '=', False), '|', ('plm_access_id.effective_unlink_group_ids', '=', False), ('plm_access_id.effective_unlink_group_ids', 'in', user.all_group_ids.ids)]</field>
    </record>

    <record id="group_non_plm_view_plm_document" model="ir.access">
        <field name="name">Manage PLM Document</field>
        <field name="model_id" ref="model_ir_attachment"/>
        <field name="group_id" ref="group_plm_view_user"/>
        <field name="operation">ud</field>
        <field name="domain">[('is_plm','=',True)]</field>
    </record>

    <record id="group_plm_view_user_non_plm_document" model="ir.access">
        <field name="name">View/Create Non-PLM Attachment</field>
        <field name="model_id" ref="model_ir_attachment"/>
        <field name="group_id" ref="group_plm_view_user"/>
        <field name="operation">crud</field>
        <field name="domain">[('is_plm','=',False)]</field>
    </record>

    <record id="group_plm_view_released_document" model="ir.access">
        <field name="name">View only released Documnet</field>
        <field name="model_id" ref="model_ir_attachment"/>
        <field name="group_id" ref="group_plm_release_document"/>
        <field name="operation">r</field>
        <field name="domain">[('is_plm','=',True),('engineering_state','in',['released','obsoleted','undermodify'])]</field>
    </record>


