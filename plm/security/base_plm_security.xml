<!-- product.product  -->
    <record id="plm_product_product_view" model="ir.access">
        <field name="name">PLM Product Product</field>
        <field name="model_id" ref="model_product_product"/>
        <field name="group_id" ref="group_plm_view_user"/>
        <field name="operation">r</field>
    </record>
    <record id="plm_product_product_integration" model="ir.access">
        <field name="name">Product Product</field>
        <field name="model_id" ref="model_product_product"/>
        <field name="group_id" ref="group_plm_integration_user"/>
        <field name="operation">crud</field>
    </record>

    <record id="group_plm_readonly_released_rule_component" model="ir.access">
        <field name="name">NoWrite / NoDelete PLM Component Released</field>
        <field name="model_id" ref="model_product_product"/>
        <field name="group_id" ref="group_plm_readonly_released"/>
        <field name="operation">d</field>
        <field name="domain">[('engineering_state','not in',['draft', False])]</field>
    </record>

    <!-- Level 1, readonly state: the components it reads are the released and
         under modification ones. A global rule, because a group rule can only
         grant: it is written to leave every other PLM level untouched. -->
    <record id="plm_readonly_state_product_product" model="ir.access">
        <field name="name">PLM readonly state: component</field>
        <field name="model_id" ref="model_product_product"/>
        <field name="operation">r</field>
        <field name="domain">['|', '&amp;', ('engineering_code', '=', False), ('engineering_code_archived', '=', False), ('engineering_state', 'in', ['released', 'undermodify'])] if user.has_group('plm.group_plm_readonly_released') and not user.has_group('plm.group_plm_integration_user') else []</field>
    </record>

    <!-- Level 3, integration: deletes only its own components, and only while
         they are draft. -->
    <record id="plm_integration_unlink_product_product" model="ir.access">
        <field name="name">PLM integration deletes its own drafts: component</field>
        <field name="model_id" ref="model_product_product"/>
        <field name="group_id" ref="group_plm_integration_user"/>
        <field name="operation">d</field>
        <field name="domain">[('engineering_state', 'in', ['draft', False]), ('create_uid', '=', user.id)]</field>
    </record>

    <!-- Level 4, admin: every component, deleting included. -->
    <record id="plm_admin_product_product" model="ir.access">
        <field name="name">PLM admin: component</field>
        <field name="model_id" ref="model_product_product"/>
        <field name="group_id" ref="group_plm_admin"/>
        <field name="operation">crud</field>
        <field name="domain">[]</field>
    </record>



<!-- mrp.bom.line  -->
