<!-- mrp.bom  -->
    <record id="plm_mrp_bom_view" model="ir.access">
        <field name="name">PLM Mrp Bom</field>
        <field name="model_id" ref="model_mrp_bom"/>
        <field name="group_id" ref="group_plm_view_user"/>
        <field name="operation">r</field>
    </record>
    <record id="plm_mrp_bom_integration" model="ir.access">
        <field name="name">MRP Bom</field>
        <field name="model_id" ref="model_mrp_bom"/>
        <field name="group_id" ref="group_plm_integration_user"/>
        <field name="operation">crud</field>
    </record>

    <record id="group_plm_readonly_released_rule_bom" model="ir.access">
        <field name="name">NoWrite / NoDelete PLM BOM Released</field>
        <field name="model_id" ref="model_mrp_bom"/>
        <field name="group_id" ref="group_plm_readonly_released"/>
        <field name="operation">d</field>
        <field name="domain">[('engineering_state','not in',['draft', False])]</field>
    </record>

    <!-- Level 1, readonly state: the bill of materialss it reads are the released and
         under modification ones. A global rule, because a group rule can only
         grant: it is written to leave every other PLM level untouched. -->
    <record id="plm_readonly_state_mrp_bom" model="ir.access">
        <field name="name">PLM readonly state: bill of materials</field>
        <field name="model_id" ref="model_mrp_bom"/>
        <field name="operation">r</field>
        <field name="domain">['|', '&amp;', ('product_tmpl_id.engineering_code', '=', False), ('product_tmpl_id.engineering_code_archived', '=', False), ('engineering_state', 'in', ['released', 'undermodify'])] if user.has_group('plm.group_plm_readonly_released') and not user.has_group('plm.group_plm_integration_user') else []</field>
    </record>

    <!-- Level 3, integration: deletes only its own bill of materialss, and only while
         they are draft. -->
    <record id="plm_integration_unlink_mrp_bom" model="ir.access">
        <field name="name">PLM integration deletes its own drafts: bill of materials</field>
        <field name="model_id" ref="model_mrp_bom"/>
        <field name="group_id" ref="group_plm_integration_user"/>
        <field name="operation">d</field>
        <field name="domain">[('engineering_state', 'in', ['draft', False]), ('create_uid', '=', user.id)]</field>
    </record>

    <!-- Level 4, admin: every bill of materials, deleting included. -->
    <record id="plm_admin_mrp_bom" model="ir.access">
        <field name="name">PLM admin: bill of materials</field>
        <field name="model_id" ref="model_mrp_bom"/>
        <field name="group_id" ref="group_plm_admin"/>
        <field name="operation">crud</field>
        <field name="domain">[]</field>
    </record>

<!-- plm.client  -->
