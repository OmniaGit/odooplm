<!-- plm.checkout  -->
    <record id="plm_checkout_view" model="ir.access">
        <field name="name">PLM Check Out</field>
        <field name="model_id" ref="model_plm_checkout"/>
        <field name="group_id" ref="group_plm_view_user"/>
        <field name="operation">r</field>
    </record>
    <!-- plm_checkout_integration was previously declared twice under the same
         xml id (perm_unlink 0, then 1); the second record silently overwrote
         the first on load, so the live permission was already "crud". Kept as
         a single record here with that same effective permission (no behavior
         change per migration policy). -->
    <record id="plm_checkout_integration" model="ir.access">
        <field name="name">PLM Check Out</field>
        <field name="model_id" ref="model_plm_checkout"/>
        <field name="group_id" ref="group_plm_integration_user"/>
        <field name="operation">crud</field>
    </record>

    <!--
        A check-out is the lock one user put on a document, and deleting it is
        what checks the document back in. The access right above says the
        integration level may delete; these rules say whose. Without them every
        integration user released the locks of every other, and the model's
        unlink() does not look at the owner either.

        The administrator needs its own rule because it belongs to the
        integration group by implication: permissions are OR-ed, so this is what
        keeps it able to release a lock somebody left behind.
    -->
    <record id="plm_checkout_own_unlink" model="ir.access">
        <field name="name">PLM check-out: release your own</field>
        <field name="model_id" ref="model_plm_checkout"/>
        <field name="group_id" ref="group_plm_integration_user"/>
        <field name="operation">d</field>
        <field name="domain">[('userid', '=', user.id)]</field>
    </record>

    <record id="plm_checkout_admin_unlink" model="ir.access">
        <field name="name">PLM check-out: the administrator releases any</field>
        <field name="model_id" ref="model_plm_checkout"/>
        <field name="group_id" ref="group_plm_admin"/>
        <field name="operation">d</field>
        <field name="domain">[(1, '=', 1)]</field>
    </record>




