<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="odooplm_module_category" model="ir.module.category">
        <field name="name">OdooPLM</field>
    </record>

   <record model="res.groups.privilege" id="res_groups_privilege_odooplm">
       <field name="name">OdooPLM</field>
       <field name="category_id" ref="plm.odooplm_module_category"/>
   </record>

    <!-- View User  -->
    <record id="group_plm_view_user" model="res.groups">
        <field name="name">OdooPLM - View User</field>
        <field name="privilege_id" ref="res_groups_privilege_odooplm"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>

    <!-- Integration User  -->
    <record id="group_plm_integration_user" model="res.groups">
        <field name="name">OdooPLM - Integration User</field>
        <field name="privilege_id" ref="res_groups_privilege_odooplm"/>
        <field name="implied_ids" eval="[(4, ref('group_plm_view_user'))]"/>

    </record>

    <!-- Administrator  -->
    <record id="group_plm_admin" model="res.groups">
        <field name="name">OdooPLM - Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_odooplm"/>
        <field name="implied_ids" eval="[(4, ref('group_plm_integration_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Un release user  -->
    <record id="group_plm_admin_unrelease" model="res.groups">
        <field name="name">OdooPLM - Unrelease User</field>
        <field name="privilege_id" ref="res_groups_privilege_odooplm"/>
        <field name="implied_ids" eval="[(4, ref('group_plm_admin'))]"/>
    </record>

    <!-- Readonly Released: the lowest of the four PLM levels (readonly state,
         readonly, integration, admin). It implies the readonly group for its
         access rights, and the global rules below cut what it sees down to the
         released and under modification records. It used to imply the
         integration group, which gave it the write and create it is named
         after not having. -->
    <record id="group_plm_readonly_released" model="res.groups">
        <field name="name">OdooPLM - PLM Integration Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_odooplm"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_plm_view_user')])]"/>
    </record>

    <record id="group_plm_release_users" model="res.groups">
        <field name="name">OdooPLM - PLM / Release Users</field>
        <field name="privilege_id" ref="plm.res_groups_privilege_odooplm"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- The same level as group_plm_readonly_released, kept for the databases
         that already use it: it implies it and carries no rule of its own. -->
    <record id="group_plm_release_document" model="res.groups">
        <field name="name">OdooPLM - View only released document</field>
        <field name="privilege_id" ref="plm.res_groups_privilege_odooplm"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_plm_readonly_released')])]"/>
    </record>

<!-- model_plm_backupdoc_wizard -->
    <!-- Originally granted zero operations (r=w=c=u=0) for group_plm_view_user, i.e.
         already a no-op. ir.access requires a non-empty operation, so it's kept
         inactive here instead: same zero-permission effect, xml id stays resolvable
         for anything that might reference it. -->
    <record id="plm_plm_backupdoc_wizard_view" model="ir.access">
        <field name="name">PLM Backupdoc Wizard</field>
        <field name="model_id" ref="model_plm_backupdoc_wizard"/>
        <field name="group_id" ref="group_plm_view_user"/>
        <field name="operation">r</field>
        <field name="active" eval="False"/>
    </record>

    <record id="plm_plm_backupdoc_wizard_integration" model="ir.access">
        <field name="name">PLM Backupdoc Wizard</field>
        <field name="model_id" ref="model_plm_backupdoc_wizard"/>
        <field name="group_id" ref="group_plm_integration_user"/>
        <field name="operation">cru</field>
    </record>

    <record id="model_plm_backupdoc_wizard_admin" model="ir.access">
        <field name="name">PLM Backupdoc Wizard</field>
        <field name="model_id" ref="model_plm_backupdoc_wizard"/>
        <field name="group_id" ref="group_plm_admin"/>
        <field name="operation">crud</field>
    </record>

    <record id="model_plm_bom_report_wizard_user" model="ir.access">
        <field name="name">PLM BoM Report Wizard</field>
        <field name="model_id" ref="model_plm_bom_report_wizard"/>
        <field name="group_id" ref="group_plm_view_user"/>
        <field name="operation">crud</field>
    </record>

<!-- model_plm_temporary -->
