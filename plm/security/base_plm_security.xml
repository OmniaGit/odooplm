<!-- product.template  -->
    <record id="plm_product_template_view" model="ir.access">
        <field name="name">Product Template</field>
        <field name="model_id" ref="model_product_template"/>
        <field name="group_id" ref="group_plm_view_user"/>
        <field name="operation">r</field>
    </record>
    <record id="plm_product_template_integration" model="ir.access">
        <field name="name">Product Template</field>
        <field name="model_id" ref="model_product_template"/>
        <field name="group_id" ref="group_plm_integration_user"/>
        <field name="operation">crud</field>
    </record>

    <!-- Level 1, readonly state: the component templates it reads are the released and
         under modification ones. A global rule, because a group rule can only
         grant: it is written to leave every other PLM level untouched. -->
    <record id="plm_readonly_state_product_template" model="ir.access">
        <field name="name">PLM readonly state: component template</field>
        <field name="model_id" ref="model_product_template"/>
        <field name="operation">r</field>
        <field name="domain">['|', '&amp;', ('engineering_code', '=', False), ('engineering_code_archived', '=', False), ('engineering_state', 'in', ['released', 'undermodify'])] if user.has_group('plm.group_plm_readonly_released') and not user.has_group('plm.group_plm_integration_user') else []</field>
    </record>

    <!-- Level 3, integration: deletes only its own component templates, and only while
         they are draft. -->
    <record id="plm_integration_unlink_product_template" model="ir.access">
        <field name="name">PLM integration deletes its own drafts: component template</field>
        <field name="model_id" ref="model_product_template"/>
        <field name="group_id" ref="group_plm_integration_user"/>
        <field name="operation">d</field>
        <field name="domain">[('engineering_state', 'in', ['draft', False]), ('create_uid', '=', user.id)]</field>
    </record>

    <!-- Level 4, admin: every component template, deleting included. -->
    <record id="plm_admin_product_template" model="ir.access">
        <field name="name">PLM admin: component template</field>
        <field name="model_id" ref="model_product_template"/>
        <field name="group_id" ref="group_plm_admin"/>
        <field name="operation">crud</field>
        <field name="domain">[]</field>
    </record>



