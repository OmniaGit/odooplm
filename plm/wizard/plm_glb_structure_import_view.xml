<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_plm_glb_structure_import_form" model="ir.ui.view">
        <field name="name">plm.glb.structure.import.form</field>
        <field name="model">plm.glb.structure.import</field>
        <field name="arch" type="xml">
            <form string="Import GLB structure">
                <field name="state" invisible="1"/>
                <div invisible="state != 'draft'">
                    <p>
                        Load the zip written by OmniaGLTFConverter with "All files with data":
                        its .glb files and structure.json. Every document of the json gets its
                        component and its .glb, linked to the component and, when Odoo has the
                        native CAD document, attached to it for the 3D viewer: no native document
                        is created. The .glb of an assembly is linked to its children's, and the
                        assemblies get their BoM.
                    </p>
                    <group>
                        <field name="zip_file" filename="zip_name"/>
                        <field name="zip_name" invisible="1"/>
                        <field name="force_product_images"/>
                        <field name="bom_mode" widget="radio"/>
                    </group>
                    <div class="text-muted">
                        <p>
                            <b>With references to the web files</b>: every BoM line has the
                            assembly's .glb as source document, so a new import of the same zip
                            updates the lines.
                        </p>
                        <p>
                            <b>Without references</b>: the lines hold only the component and its
                            quantity. A new import cannot tell them apart, so it leaves out an
                            assembly whose BoM already has lines: delete the BoM before
                            re-importing.
                        </p>
                    </div>
                </div>
                <group invisible="state != 'done'">
                    <field name="result" nolabel="1" colspan="2"/>
                    <field name="document_ids" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_open_documents" string="Open the documents" type="object"
                            class="btn-primary" invisible="state != 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_plm_glb_structure_import" model="ir.actions.act_window">
        <field name="name">Import GLB structure (zip)</field>
        <field name="res_model">plm.glb.structure.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- Opened from the Import GLB button of the document views, not from the Action menu -->
        <field name="binding_model_id" eval="False"/>
        <field name="group_ids" eval="[(4, ref('plm.group_plm_integration_user'))]"/>
    </record>
</odoo>
