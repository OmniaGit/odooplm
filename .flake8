[flake8]
max-line-length = 88
max-complexity = 16
# B = bugbear; no B9 to skip B950 line-length (black already enforces 88)
select = C,E,F,W,B
# E203: whitespace before ':' (black behaviour)
# E501: flake8 line length (covered by black)
# W503: line break before binary operator (black behaviour)
# B006: mutable default arguments (pre-existing pattern)
# B904: raise-from in except blocks (pre-existing pattern)
# B007: unused loop variable (pre-existing pattern)
# C901: too complex (pre-existing pattern, max-complexity already set)
# E741: ambiguous variable name (pre-existing pattern)
# B023: function in loop (pre-existing pattern)
# B907: use repr() (pre-existing pattern)
# E722: bare except (pre-existing pattern)
# B902: staticmethod candidate (pre-existing pattern)
# B020: loop var shadows builtin (pre-existing pattern)
# B015: pointless comparison (pre-existing pattern)
# B001: assert in non-test (pre-existing pattern)
# E713: use not-in (pre-existing pattern)
# B909: mutation of loop iterable (pre-existing pattern)
# E712: comparison to True/False (common Odoo pattern)
# F821: undefined name (pre-existing; many in unreachable/generated code)
# F811: redefinition of unused name (pre-existing)
# F841: local variable assigned but never used (pre-existing)
# F402: import-star shadow (pre-existing)
ignore = E203,E501,W503,B006,B904,B007,C901,E741,B023,B907,E722,B902,B020,B015,B001,E713,B909,E712,F821,F811,F841,F402
per-file-ignores=
    __init__.py:F401
    __manifest__.py:B018
