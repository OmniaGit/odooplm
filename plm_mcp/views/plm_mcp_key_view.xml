<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="plm_mcp_key_form" model="ir.ui.view">
        <field name="name">plm.mcp.key.form</field>
        <field name="model">plm.mcp.key</field>
        <field name="arch" type="xml">
            <form string="MCP API Key">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="expires_on"/>
                        <field name="active"/>
                    </group>
                    <!-- Shown only on the response that created the key: the
                         token is never stored, so reloading the form loses it. -->
                    <group string="Token" invisible="not key_clear">
                        <field name="key_clear" readonly="1"
                               help="Copy it now — it cannot be shown again."/>
                    </group>
                    <group string="Usage">
                        <field name="key_preview"/>
                        <field name="last_used_on"/>
                        <field name="call_count"/>
                    </group>
                    <footer>
                        <button name="action_regenerate" type="object"
                                string="Regenerate token"
                                confirm="The current token stops working immediately. Continue?"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="plm_mcp_key_list" model="ir.ui.view">
        <field name="name">plm.mcp.key.list</field>
        <field name="model">plm.mcp.key</field>
        <field name="arch" type="xml">
            <list string="MCP API Keys">
                <field name="name"/>
                <field name="user_id"/>
                <field name="key_preview"/>
                <field name="last_used_on"/>
                <field name="call_count"/>
                <field name="expires_on"/>
            </list>
        </field>
    </record>

    <record id="plm_mcp_key_action" model="ir.actions.act_window">
        <field name="name">MCP API Keys</field>
        <field name="res_model">plm.mcp.key</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="plm_mcp_key_menu" name="MCP API Keys"
              parent="plm.plm_menu" sequence="30"
              action="plm_mcp_key_action"
              groups="plm.group_plm_admin"/>

</odoo>
