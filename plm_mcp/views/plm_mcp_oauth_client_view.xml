<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="plm_mcp_oauth_client_form" model="ir.ui.view">
        <field name="name">plm.mcp.oauth.client.form</field>
        <field name="model">plm.mcp.oauth.client</field>
        <field name="arch" type="xml">
            <form string="MCP OAuth Client">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Create an OAuth client to connect PLM to an AI application
                        through the MCP server. Give the Client ID below to the AI
                        application as its OAuth client ID, and add the redirect
                        URL of that application in Redirect URIs. Each AI
                        application has its own redirect URL: check its
                        documentation. The person then logs in to Odoo and allows
                        the connection, and the application gets an MCP API Key
                        without anything being copied by hand.
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="client_id"/>
                        <field name="redirect_uris" placeholder="https://client.example/callback"/>
                        <field name="active"/>
                        <field name="source"/>
                        <field name="last_used_on"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="plm_mcp_oauth_client_list" model="ir.ui.view">
        <field name="name">plm.mcp.oauth.client.list</field>
        <field name="model">plm.mcp.oauth.client</field>
        <field name="arch" type="xml">
            <list string="MCP OAuth Clients">
                <field name="name"/>
                <field name="client_id"/>
                <field name="redirect_uris"/>
                <field name="source"/>
                <field name="last_used_on"/>
            </list>
        </field>
    </record>

    <record id="plm_mcp_oauth_client_action" model="ir.actions.act_window">
        <field name="name">MCP OAuth Clients</field>
        <field name="res_model">plm.mcp.oauth.client</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="plm_mcp_oauth_client_menu" name="OAuth Clients"
              parent="plm_mcp_menu" sequence="2"
              action="plm_mcp_oauth_client_action"
              groups="plm.group_plm_admin"/>

</odoo>
