<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- View User  -->
        <record model="res.groups.privilege" id="res_groups_privilege_odooplm">
            <field name="name">OdooPLM</field>
            <field name="category_id" ref="plm.odooplm_module_category"/>
        </record>

        <record id="group_force_activity_validation_admin" model="res.groups">
            <field name="name">Force Activity Validation</field>
            <field name="privilege_id" ref="res_groups_privilege_odooplm"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_force_activity_validation_user" model="res.groups">
            <field name="name">Activity User</field>
            <field name="privilege_id" ref="res_groups_privilege_odooplm"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_force_activity_validation_user_readonly" model="res.groups">
            <field name="name">Activity User Readonly</field>
            <field name="privilege_id" ref="res_groups_privilege_odooplm"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- mail.activity.children.rel  -->
        <record id="mail_activity_validation_children_readonly" model="ir.access">
            <field name="name">Mail activity validation readonly</field>
            <field name="model_id" ref="model_mail_activity_children_rel"/>
            <field name="group_id" ref="activity_validation.group_force_activity_validation_user_readonly"/>
            <field name="operation">r</field>
        </record>

        <record id="mail_activity_validation_children_validation" model="ir.access">
            <field name="name">Mail activity validation children</field>
            <field name="model_id" ref="model_mail_activity_children_rel"/>
            <field name="group_id" ref="activity_validation.group_force_activity_validation_user"/>
            <field name="operation">crud</field>
        </record>

        <record id="mail_activity_validation_children_admin" model="ir.access">
            <field name="name">Mail activity validation admin</field>
            <field name="model_id" ref="model_mail_activity_children_rel"/>
            <field name="group_id" ref="activity_validation.group_force_activity_validation_admin"/>
            <field name="operation">crud</field>
        </record>

        <!-- Two distinct rules were previously declared under the same XML id
             (mail_activity_children_rel_shedule), so the second silently
             overwrote the first on load instead of creating a separate row.
             Split into their own ids so both actually apply: read-only for
             everyone, full CRUD for the Activity User group. -->
        <record id="mail_activity_children_rel_shedule_readonly" model="ir.access">
            <field name="name">Mail activity validation schedule readonly</field>
            <field name="model_id" ref="model_mail_activity_children_rel_shedule"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="operation">r</field>
        </record>

        <record id="mail_activity_children_rel_shedule_validation" model="ir.access">
            <field name="name">Mail activity validation schedule</field>
            <field name="model_id" ref="model_mail_activity_children_rel_shedule"/>
            <field name="group_id" ref="activity_validation.group_force_activity_validation_user"/>
            <field name="operation">crud</field>
        </record>
    </data>
</odoo>
