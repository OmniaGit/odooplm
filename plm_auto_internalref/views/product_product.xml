<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_product_search_int_ref" model="ir.ui.view">
        <field name="name">product.product.search.int.ref</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="plm.plm_component_base_search" />
        <field name="arch" type="xml">
            <field name="engineering_code" position="after">
                <field name="default_code" />
            </field>
        </field>
    </record>

    <!-- The internal reference is read only while it is computed; the toggle that
         sets it is on its row, without a label -->
    <record id="product_template_only_form_view_auto_default_code" model="ir.ui.view">
        <field name="name">product.template.form.auto.default.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <!-- applied after the views that put a field after default_code (plm_consumption_plans
             has 101), so that only default_code moves into the row -->
        <field name="priority" eval="200" />
        <field name="arch" type="xml">
            <field name="default_code" position="attributes">
                <attribute name="readonly">auto_default_code and engineering_code and engineering_code != '-'</attribute>
            </field>
            <field name="default_code" position="before">
                <label
                    for="default_code"
                    string="Reference"
                    invisible="product_variant_count &gt; 1"
                />
                <div
                    name="auto_default_code_row"
                    class="o_row"
                    invisible="product_variant_count &gt; 1"
                >
                    <field
                        name="auto_default_code"
                        widget="boolean_toggle"
                        nolabel="1"
                        invisible="not engineering_code or engineering_code == '-'"
                    />
                </div>
            </field>
            <xpath expr="//div[@name='auto_default_code_row']/field[@name='auto_default_code']" position="before">
                <xpath expr="//field[@name='default_code']" position="move" />
            </xpath>
        </field>
    </record>

    <record id="product_normal_form_view_auto_default_code" model="ir.ui.view">
        <field name="name">product.product.form.auto.default.code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <!-- applied after the views that put a field after default_code (plm_consumption_plans
             has 101), so that only default_code moves into the row -->
        <field name="priority" eval="200" />
        <field name="arch" type="xml">
            <field name="default_code" position="attributes">
                <attribute name="readonly">auto_default_code and engineering_code and engineering_code != '-'</attribute>
            </field>
            <field name="default_code" position="before">
                <label for="default_code" />
                <div name="auto_default_code_row" class="o_row">
                    <field
                        name="auto_default_code"
                        widget="boolean_toggle"
                        nolabel="1"
                        invisible="not engineering_code or engineering_code == '-'"
                    />
                </div>
            </field>
            <xpath expr="//div[@name='auto_default_code_row']/field[@name='auto_default_code']" position="before">
                <xpath expr="//field[@name='default_code']" position="move" />
            </xpath>
        </field>
    </record>

    <record id="product_variant_easy_edit_view_auto_default_code" model="ir.ui.view">
        <field name="name">product.product.easy.edit.auto.default.code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view" />
        <!-- applied after the views that put a field after default_code (plm_consumption_plans
             has 101), so that only default_code moves into the row -->
        <field name="priority" eval="200" />
        <field name="arch" type="xml">
            <field name="default_code" position="attributes">
                <attribute name="readonly">auto_default_code and engineering_code and engineering_code != '-'</attribute>
            </field>
            <field name="default_code" position="before">
                <field name="engineering_code" invisible="1" />
                <label for="default_code" />
                <div name="auto_default_code_row" class="o_row">
                    <field
                        name="auto_default_code"
                        widget="boolean_toggle"
                        nolabel="1"
                        invisible="not engineering_code or engineering_code == '-'"
                    />
                </div>
            </field>
            <xpath expr="//div[@name='auto_default_code_row']/field[@name='auto_default_code']" position="before">
                <xpath expr="//field[@name='default_code']" position="move" />
            </xpath>
        </field>
    </record>
</odoo>
